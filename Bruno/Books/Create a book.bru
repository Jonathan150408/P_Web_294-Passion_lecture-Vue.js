  auth: inherit
}

body:json {
  {
    "title" : "Something strange happened",
    "numberOfPages" : 319,
    "pdfLink" : "/false",
    "abstract" : "Just an easter egg for Noe to find",
    "editionYear" : "2025",
    "imagePath" : "./true",
    "userId" : 1,
    "writerId" : 2,
    "editorsIds" : [3, 4],
    "categoriesIds" : [1, 2]
    
    
    
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
