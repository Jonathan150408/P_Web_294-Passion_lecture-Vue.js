// Import de Axios
import axios from 'axios'

// Création de l'instance de Axios
const apiClient = axios.create({
  baseURL: 'http://localhost:3333/api/books/',
  withCredentials: true,
  headers: {
    Accept: 'application/json',
    'Content-Type': 'application/json',
  },
})

// Mettre à dispo
export default {
  // Get all comments of a books
  async getComments(bookId, page = 1, limit = 20) {
    const params = new URLSearchParams({ page, limit })

    return await apiClient.get(`${bookId}/comments?${params}`)
  },

  // Get a singular comment
  async getComment(bookId, commentId) {
    return await apiClient.get(`${bookId}/comments/${commentId}`)
  },

  // Create a comment
  async createComment(bookId, commentData) {
    return await apiClient.post(`${bookId}/comments/`, commentData)
  },

  // Update a comment
  async updateComment(bookId, commentData) {
    return await apiClient.put(`${bookId}/comments/${commentData.id}`, commentData)
  },

  // Delete a comment
  async deleteComment(bookId, commentId) {
    return await apiClient.delete(`${bookId}/comments/${commentId}`)
  },
}
